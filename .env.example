# Copy to .env next to docker-compose.yml. Values here are per-deployment and are not
# committed; docker compose picks .env up automatically.

# Path a reverse proxy mounts the dashboard under. Leave blank when served at the root.
#   nginx:  location /4000/ { proxy_pass http://localhost:4000/; }
#   ->      BASE_PATH=/4000
BASE_PATH=

# Hostname encoders should use to reach the RTMP port. Leave blank to auto-detect, which
# only works when not behind Docker or NAT.
#   PUBLIC_HOST=stream.example.com
PUBLIC_HOST=

# "true" only if the dashboard is reached exclusively over HTTPS.
SECURE_COOKIES=
