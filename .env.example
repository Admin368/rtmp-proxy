# Copy to .env next to docker-compose.yml. Values here are per-deployment and are not
# committed; docker compose picks .env up automatically.

# Path a reverse proxy mounts the dashboard under. Leave blank when served at the root.
#   nginx:  location /4000/ { proxy_pass http://localhost:4000/; }
#   ->      BASE_PATH=/4000
BASE_PATH=

# Hostname encoders should use to reach the RTMP port. Leave blank to auto-detect, which
# only works when not behind Docker or NAT.
#   PUBLIC_HOST=stream.example.com
PUBLIC_HOST=

# "true" only if the dashboard is reached exclusively over HTTPS.
SECURE_COOKIES=

# --- RTMPS (recommended) ---------------------------------------------------------------
# From v4 the API key travels on the Server URL. Plain RTMP sends the whole connect
# handshake in the clear, so anyone on the network path can read the key. RTMPS encrypts it.
# Set all three, publish the port in docker-compose.yml, and mount the certificate.
# The certificate is read once at startup, so a renewal needs a container restart.
#   RTMPS_PORT=4443
#   RTMPS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
#   RTMPS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
RTMPS_PORT=
RTMPS_KEY=
RTMPS_CERT=
